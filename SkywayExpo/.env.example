# Mapbox public token (pk.…) — used for directions and place search.
# Create one at https://account.mapbox.com/access-tokens/
# EXPO_PUBLIC_ variables are inlined into the JS bundle, so this must be a
# PUBLIC token with URL restrictions set, never a secret (sk.…) token.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Optional. Base URL of a community-report backend. Leave empty and reports
# are stored on-device only.
EXPO_PUBLIC_INCIDENT_BASE_URL=
